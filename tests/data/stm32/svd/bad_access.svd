  <peripherals>
    <peripheral>
      <name>A</name>
      <baseAddress>0x40000000</baseAddress>
      <addressBlock><offset>0</offset><size>0x400</size><usage>registers</usage></addressBlock>
      <registers>
        <register>
          <name>CR</name>
          <addressOffset>0x0</addressOffset>
          <access>bogus-access</access>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>
